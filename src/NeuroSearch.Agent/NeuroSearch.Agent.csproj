<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- SK/Ollama need reflection-based JSON at runtime; keep enabled for reliable agent operation.
         AOT publish still works with TrimmerRootAssembly roots below. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0070;IL2026;IL3050;NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.78.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.78.0-alpha" />
    <PackageReference Include="Qdrant.Client" Version="1.13.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeuroSearch.Plugins\NeuroSearch.Plugins.csproj" />
    <ProjectReference Include="..\NeuroSearch.Core\NeuroSearch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Keep plugin KernelFunction methods + Ollama request DTOs visible under Native AOT / trimming -->
  <ItemGroup>
    <TrimmerRootAssembly Include="NeuroSearch.Plugins" />
    <TrimmerRootAssembly Include="NeuroSearch.Core" />
    <TrimmerRootAssembly Include="Microsoft.SemanticKernel" />
    <TrimmerRootAssembly Include="Microsoft.SemanticKernel.Abstractions" />
    <TrimmerRootAssembly Include="Microsoft.SemanticKernel.Connectors.Ollama" />
    <TrimmerRootAssembly Include="OllamaSharp" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.AI" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

</Project>
